# Copy to config.env and fill in. config.env is git-ignored.

# Stellar CLI network name (see `stellar network ls`): testnet, mainnet, ...
NETWORK=testnet

# Stellar CLI identity that signs transactions (see `stellar keys ls`).
# It must be the manager (or the owner) of the backstop manager contract.
SOURCE=manager

# The backstop manager contract
MANAGER_ID=C...

# The backstop and pool the position is in, and the backstop tier:
# FirstLoss, SecondLoss or ThirdLoss
BACKSTOP_ID=C...
POOL_ID=C...
TIER=SecondLoss

# Slippage tolerance for joining the LP and claiming emissions, in basis
# points (100 = 1%)
SLIPPAGE_BPS=100
